{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "opencode-monitor",
  "version": "0.1.0",
  "description": "OpenCode plugin for real-time background event streaming from shell commands",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.8",
    "@opencode/schema": "^2.0.8",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@tsconfig/bun": "^1.0.0",
    "@types/bun": "^1.4.2",
    "typescript": "^5.8.0"
  }
}
